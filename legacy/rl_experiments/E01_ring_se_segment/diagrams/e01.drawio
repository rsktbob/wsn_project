tryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="glob" target="cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat" target="enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="enc" target="h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h" target="V"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h" target="A"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="V" value="&lt;b&gt;V 分支 · 1 個數&lt;/b&gt;&lt;br&gt;128 → 64 → 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="464" width="260" height="56" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;A 分支 · 4 個數&lt;/b&gt;&lt;br&gt;128 → 64 → 4（第 k 個固定是第 k 段）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="464" width="300" height="56" as="geometry"/></mxCell><mxCell id="Q" value="&lt;b&gt;Q(s,k) = V + A_k − mean A · 4 個數&lt;/b&gt;&lt;br&gt;V 對 4 段相同；段之間的差異來自 A" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="572" width="480" height="56" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;選 Q 最大的段&lt;/b&gt;&lt;br&gt;訓練 ε-greedy；拿去交換、突變" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="668" width="300" height="56" as="geometry"/></mxCell><mxCell id="evq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="V" target="Q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eaq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="Q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eqo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Q" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;" vertex="1" parent="1"><mxGeometry x="180" y="754" width="14" height="12" as="geometry"/></mxCell><mxCell id="lt0" value="輸入" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="200" y="748" width="60" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;" vertex="1" parent="1"><mxGeometry x="270" y="754" width="14" height="12" as="geometry"/></mxCell><mxCell id="lt1" value="有參數的網路（共 41,157 個參數）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="290" y="748" width="300" height="24" as="geometry"/></mxCell><mxCell id="train" value="&lt;b&gt;訓練（同一個網路三種）&lt;/b&gt;：D3QN＝Double DQN 1-step ＋ n-step（γ 0.5、n 3）＋ L2；&lt;b&gt;DQfD 式（主方法）&lt;/b&gt;＝再加大邊界模仿 max_k[Q(s,k)+l(a_E,k)] − Q(s,a_E)（只算在作弊版示範上，margin 0.1），示範先預訓練、再永久留在 PER；純模仿＝只有大邊界損失&lt;br&gt;&lt;b&gt;參數&lt;/b&gt;：共用層 7,808 ＋ 16,512、V 8,256 ＋ 65、A 8,256 ＋ 260 ＝ 41,157" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5F5E5A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="620" height="100" as="geometry"/></mxCell><mxCell id="tab" value="&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot;&gt;類別&lt;/th&gt;&lt;th style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot;&gt;特徵&lt;/th&gt;&lt;th style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot;&gt;維度&lt;/th&gt;&lt;th style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot;&gt;怎麼算&lt;/th&gt;&lt;th style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot;&gt;正規化&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;有效差異數分格&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;searcher、good 基因不同，且任一方解碼後有開的 sensor 數：0／1–2／3–4／≥5&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;one-hot&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;無效差異數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;基因不同、但兩方都沒開的 sensor 數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;min(x, 5) / 5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;範圍長度&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;候選範圍的 sensor 數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;÷ 最長區段長度&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;searcher 開啟比例&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;範圍內 searcher 有開的 sensor 比例&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;0–1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;good 開啟比例&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;範圍內 good 有開的 sensor 比例&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;0–1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;最低電量&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;範圍內 searcher 有開的 sensor 的最小剩餘電量&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;E / E_max（沒開時 1）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;平均電量&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;同上，平均&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;E / E_max&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;瓶頸 sensor 數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;searcher 解中 電量÷耗能 最低的 5 顆，落在範圍內的數量&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;÷ 5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;耗能占比&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;範圍內 sensor 耗能 ÷ searcher 全網耗能&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;0–1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;單一覆蓋 target 數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;範圍內開啟 sensor 負責、且只被一顆 sensor 覆蓋的 target 數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;÷ 範圍內開啟數&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;每段&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;區段近期成功率&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;本 episode 內這段最近 50 次被選時有改善的比例&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;0–1（沒紀錄 0.5）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;全域&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;搜尋進度&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;已用評估 ÷ 預算&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;0–1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;全域&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;searcher 停滯&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;searcher 連續沒改善的回合數&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;min(x, 20) / 20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;全域&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;fitness 差距&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;(f_good − f_searcher) 在本回合 64 組交易中的排名&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;0–1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;全域&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;全網電量&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;活著的 sensor 平均剩餘電量&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;&quot;&gt;E / E_max&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot; colspan=&quot;2&quot;&gt;合計&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;text-align:center;&quot;&gt;60&lt;/td&gt;&lt;td style=&quot;border:1px solid #D3D1C7;padding:2px 5px;vertical-align:top;background:#F1EFE8;font-weight:bold;&quot; colspan=&quot;2&quot;&gt;每段 14 × 4 段（依段號固定位置）＋ 全域 4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#2C2C2A;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="620" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rainbow" name="Rainbow 網路"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1430" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seg0" value="&lt;b&gt;段 0 特徵 · 14 維&lt;/b&gt;&lt;br&gt;第 0 段候選範圍內" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="140" height="56" as="geometry"/></mxCell><mxCell id="es0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seg0" target="cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seg1" value="&lt;b&gt;段 1 特徵 · 14 維&lt;/b&gt;&lt;br&gt;第 1 段候選範圍內" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;" verte
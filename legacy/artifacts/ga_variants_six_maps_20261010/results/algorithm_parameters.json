{
  "algorithms": [
    {
      "implementation": "algorithm",
      "label": "GA",
      "name": "ga",
      "parameter_basis": "Project 2023 thesis, Section 4.1: population=30, crossover=0.8. Mutation is the classic per-gene rate 1/L instead of the thesis's mutation=0.1 with one gene per selected chromosome (that was ~10x weaker; per-gene 1/L gave +7.8%/+9.5% lifetime at 1000/10000 evaluations on MAP01-06).",
      "params": {
        "cu": 0.8,
        "n": 30
      }
    },
    {
      "implementation": "algorithm",
      "label": "Elitist GA",
      "name": "ga_elitist",
      "parameter_basis": "Same initialization, integer encoding, n=30, cu=0.8 and per-gene mu=1/L as GA; carry 2 unmodified elites with cached fitness. Elite count is an exploratory, untuned default.",
      "params": {
        "cu": 0.8,
        "elite_count": 2,
        "n": 30
      }
    },
    {
      "implementation": "algorithm",
      "label": "Adaptive GA",
      "name": "ga_adaptive",
      "parameter_basis": "Project-specific adaptive mutation, not a published AGA replica: mu from 1/L to min(1,5/L), driven by normalized gene diversity below 0.3 or best-fitness stagnation over 10 generations. No elitism by default, to isolate adaptation; n=30 and cu=0.8 match GA. Exploratory, untuned defaults.",
      "params": {
        "cu": 0.8,
        "diversity_threshold": 0.3,
        "elite_count": 0,
        "mutation_multiplier": 5.0,
        "n": 30,
        "stagnation_window": 10
      }
    }
  ],

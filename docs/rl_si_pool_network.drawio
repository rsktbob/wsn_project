<mxfile host="app.diagrams.net"><diagram id="pool" name="RL_SI_SETS 選池網路"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gf" value="&lt;b&gt;每個 good 的特徵&lt;/b&gt;&lt;br&gt;4 池 × 8 個 good × 6 維" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="280" height="56" as="geometry"/></mxCell><mxCell id="ps" value="&lt;b&gt;池的統計&lt;/b&gt;&lt;br&gt;4 池 × 5 維" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="40" width="170" height="56" as="geometry"/></mxCell><mxCell id="psi" value="&lt;b&gt;good 編碼器 ψ&lt;/b&gt;&lt;br&gt;6→32→32，8 個 good 共用" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="136" width="280" height="56" as="geometry"/></mxCell><mxCell id="zp" value="&lt;b&gt;池向量 z_pool_k · 64 維&lt;/b&gt;&lt;br&gt;8 個 good 取平均 ‖ 最大" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="232" width="280" height="56" as="geometry"/></mxCell><mxCell id="V" value="&lt;b&gt;V 分支&lt;/b&gt;&lt;br&gt;[c, 4 池 z 平均] → 32 → 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="210" height="56" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;searcher 情境 c&lt;/b&gt;&lt;br&gt;進度、排名等 5 維" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="340" width="140" height="56" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;A 分支（4 池共用）&lt;/b&gt;&lt;br&gt;[c, z_k, 池統計] → 32 → 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="200" height="56" as="geometry"/></mxCell><mxCell id="Q" value="&lt;b&gt;Q(s,k) = V + A − 平均 A&lt;/b&gt;&lt;br&gt;4 個池各一個 Q 值" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="280" height="56" as="geometry"/></mxCell><mxCell id="sel" value="&lt;b&gt;選 Q 最大的池&lt;/b&gt;&lt;br&gt;訓練時用 ε-greedy 探索" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="536" width="280" height="56" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;投資照 SI_SETS 原樣（網路不參與）&lt;/b&gt;&lt;br&gt;和該池 8 個 good 交易：兩點交配＋突變" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;fontSize=12;dashed=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="632" width="380" height="56" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;" edge="1" parent="1" source="gf" target="psi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;" edge="1" parent="1" source="psi" target="zp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.232;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="zp" target="V"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.893;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="zp" target="A"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.765;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ps" target="A"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="V"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="A"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="V" target="Q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="Q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;" edge="1" parent="1" source="Q" target="sel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5F5E5A;" edge="1" parent="1" source="sel" target="inv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;每個 good 6 維&lt;/b&gt;（相對這個 searcher）：fitness 差、在 32 個 goods 的排名、基因不同比例、預期交換差異（學長交配每個基因被換到的機率 × 是否不同）、解碼後開啟集合 Jaccard、多久沒變好&lt;br&gt;&lt;b&gt;池的統計 5 維&lt;/b&gt;：這個 searcher 上次在這池的改善、多久沒來、上回合這池變好的 goods 比例、池內多樣性、這回合已選這池的 searcher 數（8 個 searcher 依序決定）&lt;br&gt;&lt;b&gt;情境 c 5 維&lt;/b&gt;：搜尋進度、searcher 排名、停滯、和全場最好解的差距、和全部 goods 的平均差異&lt;br&gt;&lt;b&gt;參數&lt;/b&gt;：ψ 1,280 ＋ V 2,273 ＋ A 2,433 ＝ 5,986；D3QN（Double DQN＋Dueling）、獎勵 A、γ 0.5、lr 1e-4" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5F5E5A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="620" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
